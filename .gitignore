# Audio/model binaries - never commit these (large, and often copyrighted
# source material). config.json/reference_mapping.json/results.md/.json
# under stem-shootout/data/songs/ are small metadata and SHOULD be tracked.
*.wav
*.flac
*.mp3
*.7z
*.afpk
*.ogg
*.pt
*.onnx
*.ckpt

# Fully regenerable by re-running the shootout, and its manifest.json
# holds this machine's absolute paths anyway - never meaningful to commit.
stem-shootout/data/songs/*/estimates/
stem-shootout/data/songs/*/reference_bucketed/
stem-shootout/data/songs/*/reference_aligned/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# Secrets — the real file lives outside this repo entirely
# (/var/www/projects/musicmod/.env), this is a defensive second layer only.
.env
.env.*
!.env.example
